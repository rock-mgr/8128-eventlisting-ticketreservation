<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Delete reservation | EventEase</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <nav class="site-nav"><a class="brand" href="/">EventEase</a>
        <div class="nav-links"><a href="/admin/events">Manage events</a><a href="/admin/reservations">Reservations</a>
        </div>
    </nav>
    <main class="container page-content narrow">
        <section class="panel confirm-delete">
            <p class="eyebrow">Reservation record</p>
            <h1>Delete this reservation?</h1>
            <p><strong>
                    <%= reservation.attendee_name %>
                </strong> · <%= reservation.event_title %>
            </p>
            <p>Confirmation code: <strong>
                    <%= reservation.confirmation_code %>
                </strong></p>
            <div class="notice notice-warning">This permanently removes the reservation and its ticket lines. The
                released tickets return to the event's available capacity.</div>
            <form method="post" action="/admin/reservations/<%= reservation.reservation_id %>/delete"
                class="form-actions"><button class="button button-danger" type="submit">Confirm deletion</button><a
                    class="button button-secondary" href="/admin/reservations">Keep reservation</a></form>
        </section>
    </main>
    <footer class="site-footer">
        <p>EventEase · Organizer reservation management</p>
    </footer>
</body>

</html>